{% schema %}
{
  "name": "Smart Product Advisor",
  "target": "body",
  "javascript": "advisor.js",
  "stylesheet": "advisor.css",
  "settings": [
    {
      "type": "color",
      "id": "button_color",
      "label": "Button Color",
      "default": "#00a853"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "Get Smart Recommendations"
    }
  ]
}
{% endschema %}

<div class="smart-advisor-container" 
     data-shop-domain="{{ shop.permanent_domain }}"
     data-api-url="https://smart-product-advisor.onrender.com"
     data-access-token="{{ shop.permanent_domain | hmac_sha256: shop.permanent_domain }}"
     data-origin="{{ shop.domain }}">
  <button 
    class="smart-advisor-button"
    style="background-color: {{ block.settings.button_color }}"
  >
    {{ block.settings.button_text }}
  </button>
  <div class="smart-advisor-modal">
    <div class="modal-content">
      <div class="modal-header">
        <h2>Find Your Perfect Match</h2>
        <button class="close-modal" aria-label="Close">×</button>
      </div>
      <form id="advisor-form" class="advisor-form">
        <div class="form-group">
          <label for="price_range">Price Range</label>
          <select name="price_range" id="price_range" required>
            <option value="">Select price range</option>
            <option value="0-50">Under £50</option>
            <option value="50-100">£50 - £100</option>
            <option value="100-200">£100 - £200</option>
            <option value="200-500">£200 - £500</option>
            <option value="500+">£500+</option>
          </select>
        </div>
        <div class="form-group">
          <label for="category">What are you looking for?</label>
          <input type="text" name="category" id="category" placeholder="e.g., home decor, furniture">
        </div>
        <div class="form-group">
          <label for="keywords">Key Features</label>
          <input type="text" name="keywords" id="keywords" placeholder="e.g., comfortable, modern">
          <small>Separate multiple features with commas</small>
        </div>
        <button type="submit" class="submit-button">Find Perfect Matches</button>
      </form>
      <div id="recommendations-container" class="recommendations-container"></div>
    </div>
  </div>
</div> 